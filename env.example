# ============================================================
# Project Tracking Agent - Environment Configuration
# ============================================================
# Copy this file to `.env` and replace the placeholder secrets.
# Keep `.env` local. Never commit real credentials or encryption keys.
#
# Required:
#   - FERNET_KEY
#   - OPENROUTER_MODEL
#   - OPENROUTER_API_KEY
#
# LangSmith variables are included for tracing. If tracing is
# enabled, provide a valid LANGSMITH_API_KEY.
# ============================================================


# ------------------------------------------------------------
# Credential encryption (REQUIRED)
# ------------------------------------------------------------
# Fernet key used to encrypt/decrypt GitHub and Linear credentials
# stored by the application.
#
# Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# IMPORTANT:
# Keep this value stable after registering integrations. Changing
# it will prevent the application from decrypting credentials that
# were encrypted using the previous key.
FERNET_KEY="<generate-a-fernet-key-and-paste-it-here>"


# ------------------------------------------------------------
# LLM provider - OpenRouter (REQUIRED)
# ------------------------------------------------------------
# Model identifier used by the application's LLM configuration.
OPENROUTER_MODEL="google/gemini-3.8-flash"

# OpenRouter API key. Replace with your own key.
OPENROUTER_API_KEY="<your-openrouter-api-key>"


# ------------------------------------------------------------
# LangSmith tracing (OPTIONAL)
# ------------------------------------------------------------
# Set to true to enable LangSmith tracing.
LANGSMITH_TRACING=true

# LangSmith API endpoint.
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# Replace with your LangSmith API key if tracing is enabled.
LANGSMITH_API_KEY="<your-langsmith-api-key>"

# Static project/agent identifier used for this application.
LANGSMITH_AGENT_ID="project-tracking"

# Environment label attached to tracing.
LANGSMITH_AGENT_ENVIRONMENT="local"
